rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kelvinandriancom@gmail.com';
    }
    
    // Existing web store products rules
    match /products/{productId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    
    // Rules for orders collection
    match /orders/{orderId} {
      // Allow users to read their own orders and admins to read all orders
      allow read: if true;
      
      // Allow users to create orders if the data matches their auth details
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.createdAt != null;
      
      // Only admin can update or delete orders
      allow update, delete: if isAdmin();
    }
    
    match /reviews/{reviewId} {
      allow write: if request.auth != null;
      allow read: if true;

      function isValidReviewId(reviewId) {
        let parts = reviewId.split('_');
        return parts.length == 2 && parts[0] == request.resource.data.orderId && parts[1] == request.auth.uid;
      }
    }

    // Rules for ZC-POS app collections
    match /User/{userId} {
      allow read, write: if request.auth != null;
    }

    match /Product/{productId} {
      allow read, write: if request.auth != null;
    }

    match /Transaction/{transactionId} {
      allow read, write: if request.auth != null;
    }

    match /OrderedProduct/{orderedProductId} {
      allow read, write: if request.auth != null;
    }
  }
}
